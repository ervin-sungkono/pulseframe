{
  "name": "pulseframe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ../scripts/prepare-lyrics-runtime.mjs && vite",
    "build": "node ../scripts/prepare-lyrics-runtime.mjs && tsc --noEmit --incremental false && vite build",
    "preview": "vite preview",
    "lint": "cd .. && app/node_modules/.bin/eslint --config app/eslint.config.mjs . && pnpm --dir app lint:css",
    "format": "prettier --ignore-path ../.prettierignore --write \"../**/*.{css,html,js,json,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"../**/*.{css,html,js,json,mjs,ts,tsx,yaml,yml}\"",
    "format:rust": "cargo fmt --manifest-path ../crates/pulseframe-dsp/Cargo.toml",
    "format:rust:check": "cargo fmt --check --manifest-path ../crates/pulseframe-dsp/Cargo.toml",
    "test": "node --test tests/*.test.mjs",
    "dsp:build": "node ../scripts/build-dsp.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:css": "stylelint \"**/*.css\" --ignore-pattern \"dist/**\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"public/**\""
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "mediabunny": "^1.58.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "@huggingface/transformers": "3.8.1",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
