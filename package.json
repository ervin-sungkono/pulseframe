{
  "name": "pulseframe-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir app run dev",
    "build": "pnpm --dir app run build",
    "preview": "pnpm --dir app run preview",
    "lint": "pnpm --dir app run lint",
    "format": "pnpm --dir app run format",
    "format:check": "pnpm --dir app run format:check",
    "format:rust": "pnpm --dir app run format:rust",
    "format:rust:check": "pnpm --dir app run format:rust:check",
    "test": "pnpm --dir app run test",
    "dsp:build": "pnpm --dir app run dsp:build",
    "typecheck": "pnpm --dir app run typecheck"
  }
}
